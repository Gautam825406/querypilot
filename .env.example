# Copy to .env — names only, no secrets. Never commit a filled-in .env.
# The backend boots with ZERO of these set (DuckDB demo + in-memory cache +
# deterministic-fallback planner), so every line below is optional.

# LLM keys (optional — without any key the planner runs in deterministic-fallback
# mode; a key only enables the direct-LLM baseline in the eval and Groq
# explanation polish)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Postgres target (optional — DuckDB demo file is the default when unset)
DATABASE_URL=postgresql://qp:qp-dev-only@localhost:5432/querypilot

# Redis cache + Celery broker (optional — in-memory cache and stored-only
# insights when unset)
REDIS_URL=redis://localhost:6379/0

# Insight notifications (optional — alerts fire ONLY on a threshold breach,
# or when an insight is paused because its SQL no longer validates)
INSIGHT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# JWT auth (optional — the default secret is dev-only; set a long random
# value in production)
QP_JWT_SECRET=
QP_JWT_EXPIRY_HOURS=24

# Limits
QP_ROW_LIMIT=100
QP_TIMEOUT_SECONDS=10
QP_CACHE_TTL=300

# Frontend
VITE_API_URL=http://localhost:8000
